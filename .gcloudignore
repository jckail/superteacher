# Upload only what the Dockerfile needs. (gcloud uses this file instead of .gitignore.)
.git
.github
.gitignore
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Secrets and local state must never ship in the build context
.env
.env.*
.session_secret
*.db
*.sqlite3
data/

# Heavy or irrelevant for the image build
web/node_modules/
web/dist/
tests/
docs/

*.db-*
*.sqlite*
web/test-results/
web/playwright-report/

infra/

.superdesign/
